{
  "name": "dsh-lifegame",
  "version": "1.0.0",
  "description": "人生游戏：把「耐心 / 轻盈 / 专注 / 健康」变成每天一屏的节奏。侧栏一个页面，Agent 在旁边随时推荐。",
  "type": "module",
  "license": "MIT",
  "author": "yonho01-collab",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "lifegame",
    "planner",
    "habit",
    "focus"
  ],
  "homepage": "https://github.com/yonho01-collab/lifegame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yonho01-collab/lifegame.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/yonho01-collab/lifegame/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "view.js",
    "tool-card.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md"
  ],
  "scripts": {
    "check": "node check-ops.mjs",
    "pack": "npm pack"
  },
  "engines": {
    "dsh": ">=0.2.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "人生游戏",
      "en": "Lifegame"
    },
    "icon": "today",
    "contributes": {
      "panels": [
        {
          "id": "today",
          "title": "今天",
          "icon": "today",
          "placement": [
            "chat.panel",
            "session.tab"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "today",
          "icon": "today",
          "panel": "today"
        }
      ]
    }
  }
}